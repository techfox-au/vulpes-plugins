root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,xml,csproj,props,targets,slnx,html,css,js,md}]
indent_size = 2

[*.cs]
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:suggestion
dotnet_diagnostic.CA2100.severity = error
dotnet_diagnostic.CA3001.severity = error
dotnet_diagnostic.CA3003.severity = error
dotnet_diagnostic.CA3006.severity = error
dotnet_diagnostic.CA5351.severity = error
dotnet_diagnostic.CA5350.severity = error
dotnet_diagnostic.CA5394.severity = none
dotnet_diagnostic.EF1002.severity = error
