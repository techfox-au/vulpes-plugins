{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore.DataProtection": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Host": {
    "DisplayName": "Vulpes",
    "AdditionalOrigins": [],
    "KnownProxies": []
  },
  "LocalAuth": {
    "PasswordLoginEnabled": true,
    "LockoutMaxAttempts": 5,
    "LockoutMinutes": 15,
    "MinPasswordLength": 12,
    "MaxPasskeysPerUser": 10,
    "RecentAuthWindowMinutes": 5,
    "SessionSlidingHours": 8,
    "SessionAbsoluteHours": 8,
    "EnrollmentTokenHours": 24
  },
  "Elasticsearch": {
    "Url": "",
    "IndexPrefix": "vc",
    "RetentionDays": 365,
    "NumberOfShards": 1,
    "NumberOfReplicas": 0
  },
  "Plugins": {
    "RequireSignature": false,
    "TrustedSigningKeys": [],
    "Settings": {
      "microsoft-365-audit": {
        "SchedulerIntervalSeconds": 20,
        "MaxConcurrentJobs": 4,
        "DefaultLookbackDays": 7,
        "LogOverlapMinutes": 30,
        "PurviewLagMinutes": 15,
        "PurviewOverlapMinutes": 60
      }
    }
  }
}
