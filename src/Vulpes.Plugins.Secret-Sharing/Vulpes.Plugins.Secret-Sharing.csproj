<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>1.0.8</Version>
    <Description>Vulpes plugin: send and collect encrypted secrets.</Description>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Vulpes.Plugins.SecretSharing</RootNamespace>
    <AssemblyName>Vulpes.Plugins.Secret-Sharing</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(VulpesRoot)src/Vulpes.Sdk/Vulpes.Sdk.csproj">
      <Private>false</Private>
    </ProjectReference>
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="docs\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
